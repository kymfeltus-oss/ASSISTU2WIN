# --- Supabase (public; safe for the browser bundle where required by the client SDK) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only; never expose to the client or commit real values) ---
# Use only in trusted server jobs (admin tooling, migrations, guarded server routes).
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (server-only) ---
OPENAI_API_KEY=

# --- Copilot intake webhook (server-only; optional Bearer auth) ---
COPILOT_INTAKE_SECRET=

# --- Cron outbox worker (server-only; Bearer auth for GET /api/cron-process-outbox) ---
CRON_SECRET=

# --- Messaging (server-only; Resend + Twilio) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Assist U 2 Win Collective <updates@assistu2win.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LiveKit (server-only secrets; WSS URL for client WebSocket) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Go-live certification (CI + local regression; server/CI only for password) ---
# Run: npm run fixtures:go-live && npm run dev (separate terminal) && npm run cert:go-live
GO_LIVE_CERT_EMAIL=
GO_LIVE_CERT_PASSWORD=
GO_LIVE_FORBIDDEN_APPOINTMENT_ID=cdc0a18e-b8de-4266-895c-5f6fea9614de
GO_LIVE_CERT_BASE_URL=http://localhost:3000
