# --- Supabase (public; safe for the browser bundle where required by the client SDK) ---
# Copy both from Supabase → Project Settings → API (Project URL + anon / publishable key).
# A stale or truncated anon key causes login to fail with "Invalid API key" (401).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only; never expose to the client or commit real values) ---
# Use only in trusted server jobs (admin tooling, migrations, guarded server routes).
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (server-only) ---
OPENAI_API_KEY=

# --- Copilot intake webhook (server-only; optional Bearer auth) ---
COPILOT_INTAKE_SECRET=

# --- Cron outbox worker (server-only; Bearer auth for GET /api/cron-process-outbox) ---
CRON_SECRET=

# --- Messaging (server-only; Resend + Twilio) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Assist U 2 Win Collective <updates@assistu2win.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Live site domain for QR codes, emails, and absolute links (no trailing slash).
NEXT_PUBLIC_APP_URL=https://your-website-domain.com

# --- Local QR testing (optional; only when NEXT_PUBLIC_APP_URL is unset in dev) ---
# NEXT_PUBLIC_DEV_APP_URL=http://192.168.1.15:3000

# --- Local dev auth (optional) ---
# Relaxed login is ON by default in `npm run dev` (stay on /login when signed in; bypass leads admin gate).
# Set NEXT_PUBLIC_AUTH_RELAXED=0 to restore strict redirects in development.
# NEXT_PUBLIC_AUTH_RELAXED=1
# NEXT_PUBLIC_PARABLE_DEV_GUEST=1

# --- LiveKit (server-only secrets; WSS URL for client WebSocket) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Go-live certification (CI + local regression; server/CI only for password) ---
# Run: npm run fixtures:go-live && npm run dev (separate terminal) && npm run cert:go-live
GO_LIVE_CERT_EMAIL=
GO_LIVE_CERT_PASSWORD=
GO_LIVE_FORBIDDEN_APPOINTMENT_ID=cdc0a18e-b8de-4266-895c-5f6fea9614de
GO_LIVE_CERT_BASE_URL=http://localhost:3000
